# Runtime
NODE_ENV=development
AURELIS_DEMO_MODE=true
APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aurelis?schema=public

# Language providers — server only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
LLM_PROVIDER_PRIMARY=simulated

# Image, motion, voice, and avatar providers — server only
IMAGE_PROVIDER_PRIMARY=simulated
MOTION_PROVIDER_PRIMARY=simulated
TTS_PROVIDER=browser-fallback
STT_PROVIDER=simulated
AVATAR_PROVIDER=simulated
RUNWAY_API_KEY=
DEEPMOTION_API_KEY=
DAILY_API_KEY=

# Research — server only
SEARCH_PROVIDER=simulated
SEARCH_PROVIDER_API_KEY=
FIRECRAWL_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Commerce — secret values stay server only
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage — server only
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Email and observability — server only except explicitly public analytics keys
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
ANALYTICS_KEY=
ERROR_MONITORING_DSN=

# Policy defaults
MAX_ARTWORK_SIMILARITY=0.78
AUTO_GENERATION_LIMIT_CENTS=25000
REFUND_APPROVAL_LIMIT_CENTS=50000

